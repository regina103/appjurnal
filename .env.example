# =====================================================================
#  .env.example — TEMPLATE (aman di-commit, TIDAK berisi nilai asli)
#
#  Cara pakai:
#  1. Salin file ini menjadi ".env.local"
#  2. Isi nilai asli dari dashboard Supabase (lihat panduan di README-SUPABASE.md)
#  3. JANGAN pernah commit ".env.local" — sudah otomatis di-ignore oleh git.
#
#  Catatan keamanan:
#  - SUPABASE_URL dan SUPABASE_ANON_KEY bersifat PUBLIK (boleh tampil di browser).
#  - SUPABASE_SERVICE_ROLE_KEY bersifat RAHASIA (bypass semua keamanan).
#    Kunci ini TIDAK dipakai di frontend. Simpan hanya untuk keperluan
#    admin/CLI dari komputer Anda. Jangan sekali-kali menaruhnya di kode klien.
# =====================================================================

# --- Publik (boleh di frontend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- RAHASIA (JANGAN taruh di frontend, JANGAN commit) ---
SUPABASE_SERVICE_ROLE_KEY=
